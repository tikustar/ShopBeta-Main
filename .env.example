# Firebase web app config (shop-day84j). Copy to .env.local.
# Values come from Firebase Console → Project settings → Your apps (web).
# The web API key is expected to be public; restrict it by HTTP referrer in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shop-day84j.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shop-day84j
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shop-day84j.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public site origin used for canonical URLs / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin SDK (scripts only — never expose to the browser)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

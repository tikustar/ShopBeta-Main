# Loaded at deploy time for Firebase Functions v2 params (defineString).
# Copy to .env and fill in values. Never commit .env (gitignored).

MAKE_WEBHOOK_URL=
KORAPAY_SECRET_KEY=
PAYSTACK_SECRET_KEY=
SQUAD_TEST_SECRET_KEY=
SQUAD_LIVE_SECRET_KEY=
SQUAD_SANDBOX=true
BACHS_SANDBOX_API_KEY=
BACHS_LIVE_API_KEY=
BACHS_SANDBOX_WEBHOOK_SECRET=
BACHS_LIVE_WEBHOOK_SECRET=
BACHS_SANDBOX=true

# Trusted origins for versioned/store-attributed webhook forwarding. No client-provided URLs are used.
# The "shopbeta" store now serves the Zenvexa brand on www.zenvexacommerce.com. The legacy
# origin keeps serving /api/* unredirected, so either value works during the transition.
SHOPBETA_WEBHOOK_ORIGIN=https://www.zenvexacommerce.com
# Origin of the separate "zenvexa" store deployment. It must not equal SHOPBETA_WEBHOOK_ORIGIN.
ZENVEXA_WEBHOOK_ORIGIN=
